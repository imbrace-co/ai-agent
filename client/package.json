    "scripts": {
        "start": "cross-env SW_DEV=true vite",
        "build": "cross-env SW=true vite build",
        "test": "react-app-rewired test",
        "lint:ts": "tsc --noEmit --pretty",
        "lint": "eslint --max-warnings=0",
        "lint:fix": "eslint --fix src --ext .ts,.tsx",
        "run:serve": "serve -s build",
        "preview": "vite preview",
        "start:local": "vite --mode local",
        "start:stg": "vite --mode stg",
        "start:prod": "vite --mode prod",
        "build:dev": "cross-env SW=true vite build --mode dev",
        "build:stg": "cross-env SW=true vite build --mode stg",
        "build:prod": "cross-env SW=true vite build --mode prod",
        "build:zungfu": "cross-env SW=true vite build --mode zungfu",
