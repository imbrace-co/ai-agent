        "build:cyberport": "cross-env SW=true vite build --mode cyberport",
        "build:nokia": "cross-env SW=true vite build --mode nokia",
        "build-release-dev": "vite build && export VITE_APP_BUILD_VERSION=\"$(git log -1 --format=%h)\" && env-cmd -f .env.staging npx react-inject-env set",
        "build-release-prod": "vite build && export VITE_APP_BUILD_VERSION=\"$(git log -1 --format=%h)\" && env-cmd -f .env.prod npx react-inject-env set"
